model Sale {
  id                 String        @id @default(uuid()) @db.Uuid
  origin             SaleOrigin
  saleNumber         String        @unique(map: "sales_sale_number_key") @default(dbgenerated("('VTA-'::text || lpad((nextval('operational_sale_number_seq'::regclass))::text, 9, '0'::text))")) @map("sale_number") @db.VarChar(80)
  businessDate       DateTime      @map("business_date") @db.Date
  status             SaleStatus
  paymentStatus      PaymentStatus @default(UNKNOWN) @map("payment_status")
  departureAt        DateTime?     @map("departure_at") @db.Timestamptz(6)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(6)
  sellerUserId       String?       @map("seller_user_id") @db.Uuid
  createdByUserId    String?       @map("created_by_user_id") @db.Uuid
  idempotencyKeyHash String?       @map("idempotency_key_hash") @db.Char(64)
  requestHash        String?       @map("request_hash") @db.Char(64)
  legacySellerText   String?       @map("legacy_seller_text") @db.VarChar(200)
  delivererText      String?       @map("deliverer_text") @db.VarChar(200)
  salesChannelText   String?       @map("sales_channel_text") @db.VarChar(160)
  paymentMethodText  String?       @map("payment_method_text") @db.VarChar(160)
  deliveryPlace      String?       @map("delivery_place")
  shippingAmount     Decimal       @default(0) @map("shipping_amount") @db.Decimal(18, 2)
  subtotal           Decimal       @db.Decimal(18, 2)
  total              Decimal       @db.Decimal(18, 2)
  currencyCode       String        @default("NIO") @map("currency_code") @db.VarChar(3)
  observations       String?
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller                User?                  @relation("SaleSeller", fields: [sellerUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User?                  @relation("SaleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items                 SaleItem[]
  cancellation          SaleCancellation?
  inTransitConfirmation InTransitConfirmation?
  legacyRecords         LegacyRecord[]         @relation("LegacyRecordSale")

  @@unique([createdByUserId, idempotencyKeyHash], map: "sales_creator_idempotency_key")
  @@index([businessDate], map: "sales_business_date_idx")
  @@index([status, businessDate], map: "sales_status_business_date_idx")
  @@index([sellerUserId, businessDate], map: "sales_seller_business_date_idx")
  @@map("sales")
}

