generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum PermissionEffect {
  GRANT
  DENY

  @@map("permission_effect")
}

enum InventoryMovementType {
  INITIAL_BALANCE
  LEGACY
  RECEIPT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SALE_CANCELLATION

  @@map("inventory_movement_type")
}

enum InventoryCountSessionStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  CANCELLED

  @@map("inventory_count_session_status")
}

enum SaleStatus {
  LEGACY_UNKNOWN
  IN_TRANSIT
  COMPLETED
  CANCELLED

  @@map("sale_status")
}

enum PaymentStatus {
  UNKNOWN
  PENDING
  PAID

  @@map("payment_status")
}

enum SaleOrigin {
  OPERATIONAL
  LEGACY_IMPORT

  @@map("sale_origin")
}

enum FinanceOrigin {
  OPERATIONAL
  LEGACY_IMPORT

  @@map("finance_origin")
}

enum FinancialEntryType {
  INCOME
  EXPENSE

  @@map("financial_entry_type")
}

enum DailyClosingStatus {
  CLOSED
  REOPENED

  @@map("daily_closing_status")
}

enum LegacySourceType {
  XLSX
  GOOGLE_SHEETS
  APPS_SCRIPT

  @@map("legacy_source_type")
}

enum ImportMode {
  DRY_RUN
  COMMIT

  @@map("import_mode")
}

enum ImportStatus {
  PENDING
  RUNNING
  COMMITTED
  FAILED
  ROLLED_BACK

  @@map("import_status")
}

enum LegacyRecordStatus {
  STAGED
  IMPORTED
  REJECTED
  REQUIRES_HUMAN_APPROVAL

  @@map("legacy_record_status")
}

enum ReconciliationSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL

  @@map("reconciliation_severity")
}

enum ReconciliationStatus {
  OPEN
  REQUIRES_HUMAN_APPROVAL
  RESOLVED

  @@map("reconciliation_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  loginIdentifier String     @unique(map: "users_login_identifier_key") @map("login_identifier") @db.VarChar(64)
  displayName     String     @map("display_name") @db.VarChar(160)
  status          UserStatus @default(PENDING_ACTIVATION)
  activatedAt     DateTime?  @map("activated_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  passwordCredential          PasswordCredential?     @relation("PasswordCredentialUser")
  credentialRevocationsIssued PasswordCredential[]    @relation("PasswordCredentialRevokedBy")
  sessions                    Session[]
  invitations                 UserInvitation[]        @relation("UserInvitationTarget")
  invitationsCreated          UserInvitation[]        @relation("UserInvitationCreatedBy")
  invitationsInvalidated      UserInvitation[]        @relation("UserInvitationInvalidatedBy")
  userRoles                   UserRole[]              @relation("UserRoleUser")
  roleGrantsIssued            UserRole[]              @relation("UserRoleGrantedBy")
  roleRevocationsIssued       UserRole[]              @relation("UserRoleRevokedBy")
  userPermissions             UserPermission[]        @relation("UserPermissionUser")
  permissionGrantsIssued      UserPermission[]        @relation("UserPermissionGrantedBy")
  permissionRevocationsIssued UserPermission[]        @relation("UserPermissionRevokedBy")
  rolePermissionGrantsIssued  RolePermission[]        @relation("RolePermissionGrantedBy")
  rolePermissionRevocations   RolePermission[]        @relation("RolePermissionRevokedBy")
  auditLogs                   AuditLog[]              @relation("AuditLogActor")
  inventoryMovements          InventoryMovement[]     @relation("InventoryMovementActor")
  inventoryTransfers          InventoryTransfer[]     @relation("InventoryTransferActor")
  sales                       Sale[]                  @relation("SaleSeller")
  salesCreated                Sale[]                  @relation("SaleCreator")
  saleCancellations           SaleCancellation[]      @relation("SaleCancellationActor")
  inTransitConfirmations      InTransitConfirmation[] @relation("InTransitConfirmationActor")
  financialEntriesCreated     FinancialEntry[]        @relation("FinancialEntryCreator")
  financialEntriesResponsible FinancialEntry[]        @relation("FinancialEntryResponsible")
  dailyClosingsClosed         DailyClosing[]          @relation("DailyClosingActor")
  dailyClosingReopenings      DailyClosingReopening[] @relation("DailyClosingReopeningActor")
  resolvedIssues              ReconciliationIssue[]   @relation("ReconciliationIssueResolver")
  countSessionsCreated        InventoryCountSession[] @relation("InventoryCountSessionCreator")
  countSessionsApproved       InventoryCountSession[] @relation("InventoryCountSessionApprover")
  countSessionsCancelled      InventoryCountSession[] @relation("InventoryCountSessionCanceller")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "roles_code_key") @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "permissions_code_key") @db.VarChar(96)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model UserRole {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  user      User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy User? @relation("UserRoleRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt], map: "user_roles_user_revoked_at_idx")
  @@index([roleId, revokedAt], map: "user_roles_role_revoked_at_idx")
  @@map("user_roles")
}

model RolePermission {
  id              String    @id @default(uuid()) @db.Uuid
  roleId          String    @map("role_id") @db.Uuid
  permissionId    String    @map("permission_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy  User?      @relation("RolePermissionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([roleId, revokedAt], map: "role_permissions_role_revoked_at_idx")
  @@index([permissionId, revokedAt], map: "role_permissions_permission_revoked_at_idx")
  @@map("role_permissions")
}

model UserPermission {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  permissionId    String           @map("permission_id") @db.Uuid
  effect          PermissionEffect @default(GRANT)
  grantedAt       DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String?          @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?          @map("revoked_by_user_id") @db.Uuid

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy  User?      @relation("UserPermissionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy  User?      @relation("UserPermissionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt], map: "user_permissions_user_revoked_at_idx")
  @@index([permissionId, revokedAt], map: "user_permissions_permission_revoked_at_idx")
  @@map("user_permissions")
}

model PasswordCredential {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId   String?   @map("revoked_by_user_id") @db.Uuid
  revokeReason      String?   @map("revoke_reason") @db.VarChar(300)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User  @relation("PasswordCredentialUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy User? @relation("PasswordCredentialRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([revokedAt], map: "password_credentials_revoked_at_idx")
  @@index([revokedByUserId, revokedAt], map: "password_credentials_revoker_time_idx")
  @@map("password_credentials")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '00:30:00'::interval)")) @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '08:00:00'::interval)")) @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, absoluteExpiresAt], map: "sessions_user_absolute_expires_at_idx")
  @@index([idleExpiresAt, revokedAt], map: "sessions_idle_expires_revoked_at_idx")
  @@index([absoluteExpiresAt, revokedAt], map: "sessions_absolute_expires_revoked_at_idx")
  @@map("sessions")
}

model UserInvitation {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique(map: "user_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt           DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '24:00:00'::interval)")) @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt       DateTime? @map("invalidated_at") @db.Timestamptz(6)
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  invalidatedByUserId String?   @map("invalidated_by_user_id") @db.Uuid
  invalidationReason  String?   @map("invalidation_reason") @db.VarChar(300)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User  @relation("UserInvitationTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy     User? @relation("UserInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invalidatedBy User? @relation("UserInvitationInvalidatedBy", fields: [invalidatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt], map: "user_invitations_expires_at_idx")
  @@index([userId, consumedAt, invalidatedAt], map: "user_invitations_user_status_idx")
  @@map("user_invitations")
}

model LoginThrottle {
  id                   String    @id @default(uuid()) @db.Uuid
  normalizedIdentifier String    @map("normalized_identifier") @db.VarChar(64)
  originHash           String    @map("origin_hash") @db.Char(64)
  failedAttemptCount   Int       @default(0) @map("failed_attempt_count") @db.SmallInt
  windowStartedAt      DateTime  @default(now()) @map("window_started_at") @db.Timestamptz(6)
  lastFailedAt         DateTime? @map("last_failed_at") @db.Timestamptz(6)
  blockedUntil         DateTime? @map("blocked_until") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([normalizedIdentifier, originHash], map: "login_throttles_identifier_origin_key")
  @@index([blockedUntil], map: "login_throttles_blocked_until_idx")
  @@index([updatedAt], map: "login_throttles_updated_at_idx")
  @@map("login_throttles")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(120)
  entityId    String?  @map("entity_id") @db.Uuid
  beforeData  Json?    @map("before_data") @db.JsonB
  afterData   Json?    @map("after_data") @db.JsonB
  requestId   String?  @map("request_id") @db.Uuid
  metadata    Json?    @db.JsonB
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entityType, entityId, occurredAt], map: "audit_logs_entity_occurred_at_idx")
  @@index([actorUserId, occurredAt], map: "audit_logs_actor_occurred_at_idx")
  @@map("audit_logs")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique(map: "warehouses_code_key") @db.VarChar(64)
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryBalances          InventoryBalance[]
  productWarehouseValuations ProductWarehouseValuation[]
  inventoryMovements         InventoryMovement[]
  outgoingInventoryTransfers InventoryTransfer[]              @relation("InventoryTransferFromWarehouse")
  incomingInventoryTransfers InventoryTransfer[]              @relation("InventoryTransferToWarehouse")
  saleItems                  SaleItem[]
  legacyRecords              LegacyRecord[]                   @relation("LegacyRecordWarehouse")
  countSessionScopes         InventoryCountSessionWarehouse[]
  countLines                 InventoryCountLine[]

  @@index([active, name], map: "warehouses_active_name_idx")
  @@map("warehouses")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique(map: "units_code_key") @db.VarChar(64)
  name      String   @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products      Product[]
  legacyRecords LegacyRecord[] @relation("LegacyRecordUnit")

  @@index([active, name], map: "units_active_name_idx")
  @@map("units")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique(map: "products_code_key") @db.VarChar(64)
  name         String   @db.VarChar(200)
  description  String?
  unitId       String?  @map("unit_id") @db.Uuid
  minimumStock Decimal  @default(0) @map("minimum_stock") @db.Decimal(18, 4)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit                       Unit?                       @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryBalances          InventoryBalance[]
  productWarehouseValuations ProductWarehouseValuation[]
  inventoryMovements         InventoryMovement[]
  inventoryTransferItems     InventoryTransferItem[]
  saleItems                  SaleItem[]
  legacyRecords              LegacyRecord[]              @relation("LegacyRecordProduct")
  countLines                 InventoryCountLine[]

  @@index([name], map: "products_name_idx")
  @@index([unitId, active], map: "products_unit_active_idx")
  @@map("products")
}

model InventoryBalance {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  warehouseId         String   @map("warehouse_id") @db.Uuid
  quantity            Decimal  @db.Decimal(18, 4)
  currentUnitPrice    Decimal? @map("current_unit_price") @db.Decimal(18, 2)
  currentUnitCost     Decimal? @map("current_unit_cost") @db.Decimal(18, 2)
  priceReviewRequired Boolean  @default(false) @map("price_review_required")
  costReviewRequired  Boolean  @default(false) @map("cost_review_required")
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyRecords LegacyRecord[] @relation("LegacyRecordInventoryBalance")

  @@unique([productId, warehouseId], map: "inventory_balances_product_warehouse_key")
  @@index([warehouseId, productId], map: "inventory_balances_warehouse_product_idx")
  @@map("inventory_balances")
}

model ProductWarehouseValuation {
  id                  String    @id @default(uuid()) @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  warehouseId         String    @map("warehouse_id") @db.Uuid
  unitPrice           Decimal?  @map("unit_price") @db.Decimal(18, 2)
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(18, 2)
  currencyCode        String    @default("NIO") @map("currency_code") @db.VarChar(3)
  observedAt          DateTime  @map("observed_at") @db.Timestamptz(6)
  effectiveAt         DateTime? @map("effective_at") @db.Timestamptz(6)
  legacyRecordId      String?   @map("legacy_record_id") @db.Uuid
  requiresHumanReview Boolean   @default(false) @map("requires_human_review")
  reviewReason        String?   @map("review_reason") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyRecord LegacyRecord? @relation(fields: [legacyRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([productId, warehouseId, observedAt(sort: Desc)], map: "product_warehouse_valuations_history_idx")
  @@index([legacyRecordId], map: "product_warehouse_valuations_legacy_record_idx")
  @@index([requiresHumanReview], map: "product_warehouse_valuations_review_idx")
  @@map("product_warehouse_valuations")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  type           InventoryMovementType
  quantityDelta  Decimal               @map("quantity_delta") @db.Decimal(18, 4)
  balanceBefore  Decimal               @map("balance_before") @db.Decimal(18, 4)
  balanceAfter   Decimal               @map("balance_after") @db.Decimal(18, 4)
  occurredAt     DateTime              @map("occurred_at") @db.Timestamptz(6)
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  sourceType     String?               @map("source_type") @db.VarChar(80)
  sourceId       String?               @map("source_id") @db.Uuid
  saleItemId     String?               @map("sale_item_id") @db.Uuid
  transferItemId String?               @map("transfer_item_id") @db.Uuid
  observation    String?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouse     Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User?                  @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  saleItem      SaleItem?              @relation(fields: [saleItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transferItem  InventoryTransferItem? @relation(fields: [transferItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyRecords LegacyRecord[]         @relation("LegacyRecordInventoryMovement")
  countLine     InventoryCountLine?    @relation("InventoryCountLineAdjustment")

  @@index([productId, warehouseId, occurredAt], map: "inventory_movements_product_warehouse_time_idx")
  @@index([type, occurredAt], map: "inventory_movements_type_time_idx")
  @@index([saleItemId], map: "inventory_movements_sale_item_idx")
  @@index([actorUserId], map: "inventory_movements_actor_idx")
  @@index([transferItemId], map: "inventory_movements_transfer_item_idx")
  @@map("inventory_movements")
}

model InventoryTransfer {
  id                 String   @id @default(uuid()) @db.Uuid
  fromWarehouseId    String   @map("from_warehouse_id") @db.Uuid
  toWarehouseId      String   @map("to_warehouse_id") @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  reason             String   @db.VarChar(500)
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(6)
  idempotencyKeyHash String   @map("idempotency_key_hash") @db.Char(64)
  requestHash        String   @map("request_hash") @db.Char(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fromWarehouse Warehouse               @relation("InventoryTransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toWarehouse   Warehouse               @relation("InventoryTransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User                    @relation("InventoryTransferActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items         InventoryTransferItem[]

  @@unique([actorUserId, idempotencyKeyHash], map: "inventory_transfers_actor_idempotency_key")
  @@index([fromWarehouseId, occurredAt(sort: Desc)], map: "inventory_transfers_from_time_idx")
