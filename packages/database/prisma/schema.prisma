  status                ReconciliationStatus   @default(OPEN)
  requiresHumanApproval Boolean                @default(false) @map("requires_human_approval")
  message               String
  details               Json?                  @db.JsonB
  entityType            String?                @map("entity_type") @db.VarChar(120)
  entityId              String?                @map("entity_id") @db.Uuid
  resolvedAt            DateTime?              @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId      String?                @map("resolved_by_user_id") @db.Uuid
  resolutionNote        String?                @map("resolution_note")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  importBatch  ImportBatch   @relation(fields: [importBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyRecord LegacyRecord? @relation(fields: [legacyRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy   User?         @relation("ReconciliationIssueResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([importBatchId, status, severity], map: "reconciliation_issues_batch_status_severity_idx")
  @@index([legacyRecordId], map: "reconciliation_issues_legacy_record_idx")
  @@map("reconciliation_issues")
}
