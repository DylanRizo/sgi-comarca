model ImportBatch {
  id             String       @id @default(uuid()) @db.Uuid
  legacySourceId String       @map("legacy_source_id") @db.Uuid
  mode           ImportMode
  status         ImportStatus @default(PENDING)
  sourceChecksum String       @map("source_checksum") @db.VarChar(128)
  mappingVersion String?      @map("mapping_version") @db.VarChar(120)
  startedAt      DateTime     @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  summary        Json?        @db.JsonB
  failureCode    String?      @map("failure_code") @db.VarChar(120)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  legacySource         LegacySource          @relation(fields: [legacySourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legacyRecords        LegacyRecord[]
  reconciliationIssues ReconciliationIssue[]

  @@index([legacySourceId, status, startedAt], map: "import_batches_source_status_started_idx")
  @@index([sourceChecksum], map: "import_batches_checksum_idx")
  @@map("import_batches")
}

model LegacyRecord {
  id                        String             @id @default(uuid()) @db.Uuid
  legacySourceId            String             @map("legacy_source_id") @db.Uuid
  importBatchId             String             @map("import_batch_id") @db.Uuid
  sourceEntity              String             @map("source_entity") @db.VarChar(120)
  legacyId                  String?            @map("legacy_id") @db.VarChar(160)
  legacyRowNumber           Int                @map("legacy_row_number")
  rawData                   Json               @map("raw_data") @db.JsonB
  rawHash                   String             @map("raw_hash") @db.VarChar(128)
  status                    LegacyRecordStatus @default(STAGED)
  targetWarehouseId         String?            @map("target_warehouse_id") @db.Uuid
  targetUnitId              String?            @map("target_unit_id") @db.Uuid
  targetProductId           String?            @map("target_product_id") @db.Uuid
  targetInventoryBalanceId  String?            @map("target_inventory_balance_id") @db.Uuid
  targetInventoryMovementId String?            @map("target_inventory_movement_id") @db.Uuid
  targetSaleId              String?            @map("target_sale_id") @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  legacySource            LegacySource                @relation(fields: [legacySourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importBatch             ImportBatch                 @relation(fields: [importBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetWarehouse         Warehouse?                  @relation("LegacyRecordWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetUnit              Unit?                       @relation("LegacyRecordUnit", fields: [targetUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetProduct           Product?                    @relation("LegacyRecordProduct", fields: [targetProductId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetInventoryBalance  InventoryBalance?           @relation("LegacyRecordInventoryBalance", fields: [targetInventoryBalanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetInventoryMovement InventoryMovement?          @relation("LegacyRecordInventoryMovement", fields: [targetInventoryMovementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetSale              Sale?                       @relation("LegacyRecordSale", fields: [targetSaleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  valuations              ProductWarehouseValuation[]
  saleItems               SaleItem[]
  financialEntries        FinancialEntry[]
  reconciliationIssues    ReconciliationIssue[]

  @@index([importBatchId, sourceEntity, legacyRowNumber], map: "legacy_records_batch_entity_row_idx")
  @@index([legacySourceId, legacyId], map: "legacy_records_source_legacy_id_idx")
  @@map("legacy_records")
}

model ReconciliationIssue {
  id                    String                 @id @default(uuid()) @db.Uuid
  importBatchId         String                 @map("import_batch_id") @db.Uuid
  legacyRecordId        String?                @map("legacy_record_id") @db.Uuid
