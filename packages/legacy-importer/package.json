{
  "name": "@sgi/legacy-importer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/legacy-importer/test --exclude packages/legacy-importer/test/**/*.integration.spec.ts",
    "test:integration": "vitest run --root ../.. --config vitest.integration.config.ts packages/legacy-importer/test/dry-run.integration.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sgi/database": "workspace:*",
    "@sgi/legacy-profiler": "workspace:*"
  },
  "devDependencies": {
    "@sgi/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "tsx": "4.23.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
