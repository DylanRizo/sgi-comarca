NODE_ENV=development
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
SESSION_COOKIE_NAME=sgi_session
AUTH_CSRF_HMAC_SECRET_BASE64=
# Local example only. Replace with an independently generated 32+ byte secret.
AUTH_ORIGIN_HMAC_SECRET_BASE64=c2dpLWxvY2FsLW9yaWdpbi1obWFjLWRldmVsb3BtZW50LW9ubHktdjE=
NEXT_PUBLIC_API_URL=http://localhost:3001
SWAGGER_ENABLED=false
LOG_LEVEL=info

POSTGRES_USER=sgi_dev
POSTGRES_PASSWORD=sgi_dev_password
POSTGRES_DB=sgi_comarca_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sgi_dev:sgi_dev_password@localhost:5433/sgi_comarca_dev?schema=public

# Daily closing rules (ADR-010).
# Tolerance below which a closing counts as balanced; each closing stores the
# value actually applied. Reopening window is in days after the business date.
CLOSING_TOLERANCE=0.50
CLOSING_REOPENING_WINDOW_DAYS=30
